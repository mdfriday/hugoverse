# ============================================
# Hugoverse Docker Configuration
# ============================================

# ---- 🔑 Master License (Optional) ----
# Free Version: Leave empty (default - 1 enterprise license included)
# Paid Version: Purchase from https://mdfriday.com/pricing
# 
# Plans:
#   - Starter: 10 licenses ($99/year)
#   - Pro: 100 licenses ($499/year)
#   - Unlimited: ∞ licenses ($2,999 one-time)
MASTER_LICENSE=

# ---- Auto Initialization ----
# Set to true to automatically configure system from environment variables
# Set to false to manually configure via http://your-domain/admin/init
AUTO_INIT=true

# ---- Domain Configuration ----
# Your domain name (required for production)
DOMAIN=example.com

# Server public IP (used for domain DNS verification)
SERVER_IP=1.2.3.4

# Site name (optional)
SITE_NAME=Hugoverse

# ---- Administrator Configuration ----
# Administrator email (required for auto-init)
ADMIN_EMAIL=admin@example.com

# Administrator password (required for auto-init)
ADMIN_PASSWORD=your_secure_password

# ---- CouchDB Configuration ----
# CouchDB administrator username
COUCHDB_USER=admin

# CouchDB administrator password (required - use strong password)
COUCHDB_PASSWORD=your_couchdb_password

# User database prefix (default: userdb-)
COUCHDB_DB_PREFIX=userdb-

# ---- DNSPod Configuration (Optional) ----
# Enable DNSPod for wildcard SSL certificate (*.example.com)
# If disabled, Caddy uses HTTP-01 challenge (single domain only)
# Get credentials at: https://console.dnspod.cn/account/token/apikey
DNSPOD_ENABLED=false
DNSPOD_ID=
DNSPOD_SECRET=

# ---- Enterprise License Auto-Generation ----
# Automatically generate enterprise license(s) on first startup
AUTO_GENERATE_ENTERPRISE_LICENSE=true

# Enterprise license plan (default: enterprise)
ENTERPRISE_LICENSE_PLAN=enterprise

# Number of licenses to generate (limited by Master License quota)
ENTERPRISE_LICENSE_COUNT=1

# Optional: Use predefined license key for first license
# ENTERPRISE_LICENSE_KEY=MDF-XXXX-XXXX-XXXX

# ---- Enterprise Site Auto-Configuration ----
# Automatically configure enterprise site routing in Caddy
AUTO_CONFIGURE_ENTERPRISE_SITE=true

# Enterprise site domain (default: same as DOMAIN)
ENTERPRISE_SITE_DOMAIN=example.com

# Enterprise site path inside container (default: /data/enterprise)
ENTERPRISE_SITE_PATH=/data/enterprise

# ---- Backup Configuration ----
# Enable automatic daily backup
BACKUP_ENABLED=true

# Backup retention in days
BACKUP_RETENTION_DAYS=7

# ---- Host bind mounts (backup / migrate) ----
# Default paths are relative to the directory containing docker-compose.yml.
# To restore: copy the whole tree back, then docker compose up -d.
# HUGOVERSE_HOST_DATA_DIR=./data/hugoverse
# COUCHDB_HOST_DATA_DIR=./data/couchdb
# CADDY_HOST_DATA_DIR=./data/caddy
# PUBLISH_HOST_DIR=./data/publish
# BACKUPS_HOST_DIR=./data/backups

# ---- Advanced Configuration ----
# Hugoverse image version
VERSION=latest

# HTTP port mapping (host port)
HTTP_PORT=80

# HTTPS port mapping (host port)
HTTPS_PORT=443

# Log level (debug, info, warn, error)
LOG_LEVEL=info
