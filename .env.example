# ============================================
# MDFriday Docker Configuration
# ============================================

# MDFriday Configuration
DOMAIN=localhost
SERVER_IP=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443

# MDFriday Admin
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=test123456

# CouchDB Admin
COUCHDB_USER=admin
COUCHDB_PASSWORD=test123456

# Caddy（Docker 容器网络地址）
CADDY_HOST=caddy
CADDY_PORT=2019

# ============================================
# DNS Provider for Wildcard TLS (DNS-01 challenge)
# ============================================
# 显式选择 provider（推荐）。可选值：tencentcloud | alidns
# 留空时，按下面 *_ENABLED 标志兼容判断（保持旧 .env.local 行为）
DNS_PROVIDER=

# 腾讯云 DNS (DNSPod) —— https://console.dnspod.cn/account/token/apikey
DNSPOD_ENABLED=false
DNSPOD_ID=
DNSPOD_SECRET=

# 阿里云 DNS (AliDNS) —— https://ram.console.aliyun.com/manage/ak
ALIDNS_ENABLED=false
ALIDNS_ACCESS_KEY_ID=
ALIDNS_ACCESS_KEY_SECRET=
